    "ai_headshot_generator": { "root": "image_generation/ai-headshot-generator", "framework": "nextjs" },
    "ai_logo_studio": { "root": "image_generation/ai-logo-studio", "framework": "nextjs" },
    "ai_meme_generator": { "root": "image_generation/ai-meme-generator", "framework": "nextjs" },
    "clearmark_ai": { "root": "image_generation/clearmark-ai", "framework": "nextjs" },
    "nano_banana_generator": { "root": "image_generation/nano-banana-generator", "framework": "nextjs" },
    "old_photo_restore": { "root": "image_generation/old-photo-restore", "framework": "nextjs" },
    "free_ai_social_media_scheduler": { "root": "platforms/Free-AI-Social-Media-Scheduler", "framework": "nextjs" },
    "client_two": {
      "root": "platforms/Open-AI-Design-Agent/client",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "server", "format": "url", "env": "SERVER_URL" }]
    },
    "server": { "root": "platforms/Open-AI-Design-Agent/server", "framework": "fastapi" },
    "open_generative_ai": { "root": "platforms/Open-Generative-AI", "framework": "nextjs" },
