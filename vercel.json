{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai_knowledge_base": { "root": "ai_agents/ai-knowledge-base", "framework": "nextjs" },
    "ai_travel_studio": { "root": "ai_agents/ai-travel-studio", "framework": "nextjs" },
    "ai_voice_agent": { "root": "ai_agents/AI-Voice-Agent/server", "framework": "fastapi" },
    "client": {
      "root": "ai_agents/AI-Voice-Agent/client",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "ai_voice_agent", "format": "url", "env": "AI_VOICE_AGENT_URL" }]
