      "root": "platforms/Open-Poe-AI/client",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "server_two", "format": "url", "env": "SERVER_2_URL" }]
    },
    "server_two": { "root": "platforms/Open-Poe-AI/server", "framework": "fastapi" },
    "ai_business_card": { "root": "portrait_avatar/ai-business-card", "framework": "nextjs" },
    "ai_character_studio": { "root": "portrait_avatar/ai-character-studio", "framework": "nextjs" },
    "ai_fitness_body_simulator": { "root": "portrait_avatar/ai-fitness-body-simulator", "framework": "nextjs" },
