    "open_character_ai": { "root": "portrait_avatar/open-character-ai", "framework": "nextjs" },
    "ai_clipping_generator": { "root": "video_generation/ai-clipping-generator", "framework": "nextjs" },
    "ai_kissing_video_generator": { "root": "video_generation/ai-kissing-video-generator", "framework": "nextjs" },
    "ai_youtube_shorts_generator": { "root": "video_generation/AI-Youtube-Shorts-Generator/server", "framework": "fastapi" },
    "client_four": {
      "root": "video_generation/AI-Youtube-Shorts-Generator/client",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "ai_youtube_shorts_generator", "format": "url", "env": "AI_YOUTUBE_SHORTS_GENERATOR_URL" }]
    },
    "client_five": {
      "root": "video_generation/Open-AI-Micro-Drama-Generator/client",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "server_three", "format": "url", "env": "MICRODRAMA_API_URL" }]
    },
    "server_three": { "root": "video_generation/Open-AI-Micro-Drama-Generator/server", "framework": "fastapi" },
    "open_ai_ugc": { "root": "video_generation/Open-AI-UGC", "framework": "nextjs" },
    "seedance_2_generator": { "root": "video_generation/seedance-2-generator", "framework": "nextjs" },
    "veo4_video_generator": { "root": "video_generation/veo4-video-generator", "framework": "nextjs" },
    "ai_resume_builder": { "root": "writing_content/ai-resume-builder", "framework": "nextjs" },
    "blogger_cms": { "root": "writing_content/blogger-cms", "framework": "nextjs" },
    "geo_checker": { "root": "writing_content/geo-checker", "framework": "nextjs" },
    "mail_wise": { "root": "writing_content/mail-wise", "framework": "nextjs" },
    "prompt_architect": { "root": "writing_content/prompt-architect", "framework": "nextjs" },
    "social_post": { "root": "writing_content/social-post", "framework": "nextjs" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "ai_voice_agent" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
